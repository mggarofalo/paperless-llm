# Copy to .env. Store the Paperless token in secrets/paperless_token.txt, not here.
PPLLM_PAPERLESS_URL=https://paperless.example.com
PPLLM_MODEL=gpt-6-sol
PPLLM_TAG=needs review
PPLLM_POLL_SECONDS=3600
PPLLM_BATCH_SIZE=5
# 0 = new documents only. Set a small positive limit BEFORE the first worker run
# to enroll that many existing documents for automatic organization.
PPLLM_BACKFILL_LIMIT=0
# Changes apply automatically; true produces local proposals without writing.
# Use a separate state volume for dry runs, or explicitly reprocess afterward.
PPLLM_DRY_RUN=false
PPLLM_MAX_STATE_MIB=2048

# Optional container path; mount the directory as described in docs/prompts.md.
# PPLLM_PROMPT_FILE=/etc/ppllm/prompts/organization.txt

# Optional Compose image override; pinned version is the default.
# PPLLM_IMAGE=ghcr.io/mggarofalo/paperless-llm:stable
