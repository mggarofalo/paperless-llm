<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings><DataCollectors>
    <DataCollector friendlyName="XPlat Code Coverage"><Configuration>
      <Format>cobertura,json</Format>
      <Exclude>[*.Tests]*,[*]System.Text.RegularExpressions.Generated.*</Exclude>
      <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
    </Configuration></DataCollector>
  </DataCollectors></DataCollectionRunSettings>
</RunSettings>
